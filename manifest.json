{
  "id": "/OliFinancas/",
  "name": "OliFinanças • Bruno & Núbia",
  "short_name": "OliFinanças",
  "description": "Gestão financeira minimalista, Previsto vs. Realizado e conciliação de extratos.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f7f8f4",
  "theme_color": "#4d7c0f",
  "icons": [
    {
      "src": "./icons/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./index.html?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "statements",
          "accept": [
            ".ofx",
            ".csv",
            ".pdf",
            ".txt",
            "application/x-ofx",
            "application/ofx",
            "text/csv",
            "application/pdf",
            "text/plain",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html?file-handler=1",
      "accept": {
        "application/pdf": [".pdf"],
        "text/csv": [".csv"],
        "application/x-ofx": [".ofx"],
        "text/plain": [".ofx", ".txt"]
      }
    }
  ]
}
